SUPABASE_URL=https://<YOUR_PROJECT>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=..  # service_role key from Supabase → Settings → API

# Cloudflare Worker proxy — REQUIRED on GitHub Actions (cloud IPs blocked from investing.com).
# See cloudflare-worker/README.md for one-time setup.
CLOUDFLARE_PROXY_URL=https://egx-data-proxy.YOUR-SUBDOMAIN.workers.dev
CLOUDFLARE_PROXY_TOKEN=

# Optional fallback — only if both Cloudflare and investing.com fail.
# Free tier: 800 req/day @ 8 req/min. Sign up at https://twelvedata.com/pricing → Basic Free
TWELVEDATA_API_KEY=
